
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // THE LIAISON MASTER KEY: Evaluated at highest priority
    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'xYAuFJclD2UiUwPAUb4vqEaaKct2' ||
        request.auth.token.email == 'admin@gamhub.com' ||
        request.auth.token.isAdmin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function belongsToCampus(campusId) {
      return request.auth.token.campusId == campusId ||
             request.auth.token.campusId == 'all' || isAdmin();
    }

    function hasRole(role) {
      return request.auth.token.role == role || isAdmin();
    }

    function isVerifiedMember() {
      return isAdmin() || (isSignedIn() && request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- GLOBAL BYPASS FOR LIAISON ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- ROOT SOCIAL ARCHITECTURE ---
    match /social_posts/{postId} {
      // THE NATIONAL FIX: Root access is strictly open for reading to avoid Liaison token races
      allow get, list: if true;
      allow create: if isVerifiedMember() && request.resource.data.content != null;
      allow update: if isAdmin() || (isOwner(resource.data.authorId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isLiaisonBoosted', 'isProtected', 'vibeLevel']));
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
      
      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if isVerifiedMember();
      }
      match /likedBy/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    match /platform_stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /spotlight/{docId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }

    match /live_broadcasts/{campusId} {
      allow list, get: if isSignedIn();
      allow write: if isAdmin() || hasRole('src');
    }

    match /registry_posts/{registryPostId} {
      allow read: if isAdmin() || hasRole('management');
      allow write: if hasRole('management');
    }

    match /src_posts/{postId} {
      allow list: if isAdmin() || isVerifiedMember();
      allow get:  if true;
      allow write: if isAdmin() || hasRole('src');
    }

    match /products/{productId} {
      allow list: if isVerifiedMember();
      allow get: if isVerifiedMember();
      allow create: if isAdmin() || (isVerifiedMember() && hasRole('vendor'));
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow list: if isVerifiedMember();
      allow get, update: if isAdmin() || (isVerifiedMember() && (
        request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.vendorId
      ));
      allow create: if isVerifiedMember() && request.resource.data.buyerId == request.auth.uid;
    }

    match /campuses/{campusId} {
      allow read, list: if true;
      allow update: if isAdmin() || (hasRole('src') && belongsToCampus(campusId));
      allow create, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isVerifiedMember();
      allow create, update: if isAdmin() || isOwner(userId);
    }

    match /chats/{chatId} {
      allow list, get, update: if isAdmin() || (isVerifiedMember() && request.auth.uid in resource.data.users);
      allow create: if isVerifiedMember();
      match /messages/{msgId} {
        allow read, create: if isAdmin() || isVerifiedMember();
      }
    }

    match /connections/{id} {
      allow list, get: if isAdmin() || isVerifiedMember();
      allow read, write: if isVerifiedMember();
    }

    match /pickup_points/{id} { allow read, list: if true; }
    
    match /manifestos/{candidateId} {
      allow read: if isSignedIn();
      allow create: if isVerifiedMember();
      allow update: if isVerifiedMember() && (isOwner(candidateId) || isAdmin());
      
      match /endorsements/{studentId} {
        allow read: if isSignedIn();
        allow create: if isVerifiedMember() && isOwner(studentId);
      }
    }
  }
}
