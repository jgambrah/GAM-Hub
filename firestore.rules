
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.isAdmin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@gamhub.com' ||
        request.auth.uid == 'xYAuFJclD2UiUwPAUb4vqEaaKct2'
      );
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || request.auth.uid == userId;
    }

    match /user_devices/{deviceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow write: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /user_behavior/{userId} {
      allow read: if isAdmin() || request.auth.uid == userId;
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /fraud_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /content_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /gift_combos/{comboId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && comboId.split('_')[1] == request.auth.uid;
    }

    match /user_achievements/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /battle_combo_leaders/{battleId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    match /creator_settings/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /creator_analytics/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isAdmin();
    }

    match /creator_subscriptions/{subId} {
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.subscriberId || 
        request.auth.uid == resource.data.creatorId || 
        isAdmin()
      );
      allow create: if isSignedIn() && request.resource.data.subscriberId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /creator_subscribers/{creatorId}/subscribers/{subscriberId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || (isSignedIn() && request.auth.uid == subscriberId);
    }

    match /wallets/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update: if isSignedIn() && request.auth.uid == userId && request.resource.data.coins < resource.data.coins;
      allow write: if isAdmin();
    }

    match /creator_wallets/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn();
    }

    match /wallet_transactions/{txId} {
      allow read: if isSignedIn() && (isAdmin() || resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow write: if isAdmin();
    }

    match /arena_tournaments/{tournamentId} {
      allow read: if isSignedIn();
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentPlayers', 'prizePool', 'updatedAt', 'status'])
      );

      match /players/{userId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.auth.uid == userId;
        allow update: if isAdmin();
      }

      match /matches/{matchId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /battle_votes/{battleId}/users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /campus_pulse/{postId} {
      allow read, list, get: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        request.auth.uid == resource.data.authorId ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes', 'commentCount', 'comebackCount', 'commerceClicks', 'trendScore', 'promotionViewsDelivered', 'isPromoted', 'reportCount', 'status'])
      );
      allow delete: if isAdmin() || request.auth.uid == resource.data.authorId;
    }

    match /arena_battles/{battleId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn() && (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'votes', 'opponentA', 'opponentB', 'reportCount', 'status'])
      );
      allow write: if isAdmin();
    }

    match /user_intelligence/{userId} {
      allow read, write: if isAdmin() || request.auth.uid == userId;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
