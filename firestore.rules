rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. NUCLEAR PRIORITY (Absolute Infrastructure & Query Handshakes - TOP)
    // -------------------------------------------------------------------------
    
    // THE CAMPUS PULSE (FLAT ARCHITECTURE)
    match /campus_pulse/{postId} {
      allow read, list, get: if request.auth != null;

      allow create: if isAdmin() || (
        request.auth.token.email_verified == true &&
        request.resource.data.campusId == request.auth.token.campusId &&
        request.resource.data.content != null
      );

      allow update, delete: if isAdmin() || 
                            request.auth.uid == resource.data.authorId;
                            
      match /comments/{id} { allow read, list: if true; allow create: if request.auth != null; }
      match /likedBy/{id} { allow read: if true; allow write: if request.auth != null; }
      match /burnedBy/{id} { allow read: if true; allow write: if request.auth != null; }
      match /comebacks/{id} { allow read, list: if true; allow create: if request.auth != null; }
    }

    // 🏎️ TRENDING ENGINE SECURITY
    match /trending_stats/{postId} {
      allow read: if true;
      // Allow incrementing counters for signed-in users
      allow write: if request.auth != null;
    }

    match /spotlight/{docId} {
      allow get, list, read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /live_broadcasts/{campusId} {
      allow get, list, read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.role == 'src');
    }

    match /manifestos/{docId} {
      allow read, list, get: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.isCandidate == true);
    }

    match /platform_stats/{allPaths=**} {
      allow read, get, list: if request.auth != null;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. MASTER HELPERS (The Fortress Gate - Poison-Free)
    // -------------------------------------------------------------------------

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.isAdmin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@gamhub.com' ||
        request.auth.uid == 'xYAuFJclD2UiUwPAUb4vqEaaKct2'
      );
    }

    function isLiaisonAdmin() { return isAdmin(); }

    function isVerifiedMember() {
      return isAdmin() || (isSignedIn() && request.auth.token.email_verified == true);
    }

    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function getUserDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getCampus() {
      return request.auth.token.campusId != null ? request.auth.token.campusId : getUserDocData().campusId;
    }

    function getRole() {
      return request.auth.token.role != null ? request.auth.token.role : getUserDocData().role;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. OFFICIAL CHANNELS (SRC & REGISTRY)
    // -------------------------------------------------------------------------

    match /registry_posts/{postId} {
      allow read, list: if isAdmin() || (
        isSignedIn() && getCampus() == resource.data.campusId && (
          resource.data.audience == "all" || resource.data.audience == getRole()
        )
      );
      allow write: if isAdmin() || (getRole() == "management" && getCampus() == request.resource.data.campusId);
    }

    match /src_posts/{postId} {
      allow read, list: if isSignedIn() && (isAdmin() || getCampus() == resource.data.campusId);
      allow write: if isAdmin() || (getRole() == "src" && getCampus() == request.resource.data.campusId);
    }

    // -------------------------------------------------------------------------
    // 4. IDENTITY & MARKETPLACE
    // -------------------------------------------------------------------------

    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isVerifiedMember());
      allow list: if isVerifiedMember();
      allow create, update: if isAdmin() || isOwner(userId);
      match /ai_assistant/{id} { allow read, write: if isOwner(userId); }
    }

    match /products/{productId} {
      allow list: if isVerifiedMember();
      allow get: if isVerifiedMember() && (
        isAdmin() || resource.data.productType != 'service' || 
        get(/databases/$(database)/documents/users/$(resource.data.vendorId)).data.trial_leads_count > 0
      );
      allow create: if isAdmin() || (isVerifiedMember() && getRole() == 'vendor');
    }

    match /orders/{orderId} {
      allow list: if isVerifiedMember(); 
      allow get, update: if isAdmin() || (isVerifiedMember() && (request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.vendorId));
      allow create, update: if isVerifiedMember();
    }

    // -------------------------------------------------------------------------
    // 5. CHATS, CONNECTIONS & GROUPS
    // -------------------------------------------------------------------------

    match /chats/{chatId} {
      allow list: if isVerifiedMember();
      allow get, update: if isAdmin() || (isVerifiedMember() && request.auth.uid in resource.data.users);
      allow create: if isVerifiedMember();
      match /messages/{msgId} {
        allow read, create: if isAdmin() || isVerifiedMember();
      }
    }

    match /connections/{id} {
      allow list: if isVerifiedMember();
      allow get: if isAdmin() || (isVerifiedMember() && (request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId));
      allow create, update: if isVerifiedMember();
    }

    match /groups/{groupId} {
      allow get, list: if isVerifiedMember();
      allow create: if isVerifiedMember();
      allow update: if isVerifiedMember() && (isAdmin() || request.auth.uid in resource.data.admins);
    }

    // -------------------------------------------------------------------------
    // 6. ARENA & LOGISTICS
    // -------------------------------------------------------------------------

    match /arena_posts/{postId} {
      allow read, list: if true;
      allow create: if isVerifiedMember();
      match /comebacks/{id} { allow read, list: if true; allow create: if isVerifiedMember() || getRole() == 'admin'; }
    }

    match /pickup_points/{id} { allow read, list: if isSignedIn(); }
    match /campuses/{id} { allow read, list: if true; }

    // -------------------------------------------------------------------------
    // 7. ADVERTISING INFRASTRUCTURE
    // -------------------------------------------------------------------------
    
    match /ad_campaigns/{adId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null; 
      allow update, delete: if isAdmin();
      
      match /impressions/{impId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read, update, delete: if false;
      }
      match /clicks/{clickId} {
        allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
        allow read, update, delete: if false;
      }
    }

    match /ad_impressions_daily/{docId} {
      allow read: if request.auth != null;
      allow write: if false; 
    }
  }
}
