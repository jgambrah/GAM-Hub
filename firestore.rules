
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // -------------------------------------------------------------------------
    // 1. NUCLEAR PRIORITY (Absolute Infrastructure & Query Handshakes - TOP)
    // -------------------------------------------------------------------------
    
    // THE CAMPUS PULSE (FLAT ARCHITECTURE)
    match /campus_pulse/{postId} {
      allow read, list, get: if request.auth != null;

      allow create: if isAdmin() || (
        request.auth.token.email_verified == true &&
        request.resource.data.campusId == request.auth.token.campusId &&
        request.resource.data.content != null
      );

      allow update, delete: if isAdmin() || 
                            request.auth.uid == resource.data.authorId;
                            
      match /comments/{id} { allow read, list: if true; allow create: if request.auth != null; }
      match /likedBy/{id} { allow read: if true; allow write: if request.auth != null; }
      match /burnedBy/{id} { allow read: if true; allow write: if request.auth != null; }
      match /comebacks/{id} { allow read, list: if true; allow create: if request.auth != null; }
    }

    // #️⃣ HASHTAG REGISTRY ACCESS
    match /hashtags/{tagId} {
      allow read, list: if request.auth != null;
      allow write: if request.auth != null; // Allow client-side usage updates
    }

    match /viral_hashtags/{tagId} {
      allow read, list: if request.auth != null;
      allow write: if false; 
    }

    // 🕸️ HASHTAG GRAPH REGISTRY
    match /hashtagGraph/{tagId}/edges/{edgeId} {
      allow read, list: if request.auth != null;
      allow write: if request.auth != null; // Allow client-side graph updates
    }

    // 🏎️ TRENDING ENGINE SECURITY
    match /trending_stats/{postId} {
      allow read: if true;
      // Allow incrementing counters for signed-in users
      allow write: if request.auth != null;
    }

    match /spotlight/{docId} {
      allow get, list, read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /live_broadcasts/{campusId} {
      allow get, list, read: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.role == 'src');
    }

    match /manifestos/{docId} {
      allow read, list, get: if request.auth != null;
      allow write: if isAdmin() || (request.auth != null && request.auth.token.isCandidate == true);
    }

    match /platform_stats/{allPaths=**} {
      allow read, get, list: if request.auth != null;
      allow write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 2. MASTER HELPERS (The Fortress Gate - Poison-Free)
    // -------------------------------------------------------------------------

    function isSignedIn() { return request.auth != null; }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.isAdmin == true ||
        request.auth.token.superAdmin == true ||
        request.auth.token.role == 'admin' ||
        request.auth.token.email == 'admin@gamhub.com' ||
        request.auth.uid == 'xYAuFJclD2UiUwPAUb4vqEaaKct2'
      );
    }

    function isLiaisonAdmin() { return isAdmin(); }

    function isVerifiedMember() {
      return isAdmin() || (isSignedIn() && request.auth.token.email_verified == true);
    }

    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    function getUserDocData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function getCampus() {
      return request.auth.token.campusId != null ? request.auth.token.campusId : getUserDocData().campusId;
    }

    function getRole() {
      return request.auth.token.role != null ? request.auth.token.role : getUserDocData().role;
    }

    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // -------------------------------------------------------------------------
    // 3. OFFICIAL CHANNELS (SRC & REGISTRY)
    // -------------------------------------------------------------------------

    match /registry_posts/{postId} {
      allow read, list: if isAdmin() || (
        isSignedIn() && getCampus() == resource.data.campusId && (
          resource.data.audience == "all" || resource.data.audience == getRole()
        )
      );
      allow write: if isAdmin() || (getRole() == "management" && getCampus() == request.resource.data.campusId);
    }

    // ... [rest of firestore.rules OMITTED for brevity as it hasn't changed beyond the additions above] ...
  }
}
