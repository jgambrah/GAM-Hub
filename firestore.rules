
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.uid == 'xYAuFJclD2UiUwPAUb4vqEaaKct2' ||
        request.auth.token.email == 'admin@gamhub.com' ||
        request.auth.token.isAdmin == true ||
        request.auth.token.role == 'admin'
      );
    }

    function isVerifiedMember() {
      return isAdmin() || (isSignedIn() && request.auth.token.email_verified == true);
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- GLOBAL BYPASS FOR LIAISON ---
    match /{document=**} {
      allow read, write: if isAdmin();
    }

    // --- UNIFIED CAMPUS PULSE ---
    match /campus_pulse/{pulseId} {
      // THE UNIFIED FIX: Root access is open for reading to avoid Liaison token lag
      allow get, list: if true;
      allow create: if isVerifiedMember() && request.resource.data.content != null;
      allow update: if isAdmin() || (isOwner(resource.data.authorId) &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['isLiaisonBoosted', 'isProtected']));
      allow delete: if isAdmin() || isOwner(resource.data.authorId);
      
      match /comments/{commentId} {
        allow read, list: if true;
        allow create: if isVerifiedMember();
      }
      match /likedBy/{userId} {
        allow read: if true;
        allow write: if isOwner(userId);
      }
    }

    match /src_posts/{postId} {
      allow list: if isAdmin() || isVerifiedMember();
      allow get:  if true;
      allow write: if isAdmin() || request.auth.token.role == 'src';
    }

    match /registry_posts/{registryPostId} {
      allow read: if isAdmin() || request.auth.token.role == 'management';
      allow write: if request.auth.token.role == 'management';
    }

    match /products/{productId} {
      allow list, get: if isVerifiedMember();
      allow create: if isAdmin() || (isVerifiedMember() && request.auth.token.role == 'vendor');
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.vendorId == request.auth.uid);
    }

    match /orders/{orderId} {
      allow list: if isVerifiedMember();
      allow get, update: if isAdmin() || (isVerifiedMember() && (
        request.auth.uid == resource.data.buyerId || request.auth.uid == resource.data.vendorId
      ));
      allow create: if isVerifiedMember() && request.resource.data.buyerId == request.auth.uid;
    }

    match /campuses/{campusId} {
      allow read, list: if true;
      allow update: if isAdmin() || (request.auth.token.role == 'src' && request.auth.token.campusId == campusId);
      allow create, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isVerifiedMember();
      allow create, update: if isAdmin() || isOwner(userId);
    }

    match /chats/{chatId} {
      allow list, get, update: if isAdmin() || (isVerifiedMember() && request.auth.uid in resource.data.users);
      allow create: if isVerifiedMember();
      match /messages/{msgId} {
        allow read, create: if isAdmin() || isVerifiedMember();
      }
    }
    
    match /platform_stats/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /spotlight/{docId} {
      allow read, list, get: if true;
      allow write: if isAdmin();
    }
  }
}
