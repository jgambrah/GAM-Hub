
{
  "entities": {
    "Campus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name", "domain", "createdAt"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "campusId": { "type": "string" },
        "role": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "qualityScore": { "type": "number", "description": "0-100 reputation score for discovery ranking." }
      },
      "required": ["id", "email", "campusId", "role"]
    },
    "MarketProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketProfile",
      "type": "object",
      "description": "Tracks a user's commercial intent and shopping behavior.",
      "properties": {
        "viewedCategories": { "type": "object" },
        "purchasedCategories": { "type": "object" },
        "favoriteVendors": { "type": "object" },
        "pricePreference": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreatorReputation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CreatorReputation",
      "type": "object",
      "description": "Represents the quality and reputation score of a content creator.",
      "properties": {
        "id": { "type": "string" },
        "qualityScore": { "type": "number" },
        "engagementRate": { "type": "number" },
        "completionRate": { "type": "number" },
        "postCount": { "type": "number" },
        "violationScore": { "type": "number" },
        "tier": { "type": "string", "enum": ["elite", "trusted", "rising", "new"] },
        "lastUpdatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "qualityScore", "lastUpdatedAt"]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product listed for sale with discovery metadata.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "salesCount": { "type": "number" },
        "viewCount": { "type": "number" },
        "rating": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campusId", "vendorId", "name", "price"]
    },
    "CampusPulse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CampusPulse",
      "type": "object",
      "description": "Represents a unified social post in the flat campus_pulse collection.",
      "properties": {
        "id": { "type": "string" },
        "campusId": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "isArenaEntry": { "type": "boolean" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "aiTags": { "type": "array", "items": { "type": "string" } },
        "aiTopics": { "type": "array", "items": { "type": "string" } },
        "mood": { "type": "string" },
        "musicGenre": { "type": "string" },
        "detectedObjects": { "type": "array", "items": { "type": "string" } },
        "transcript": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campusId", "authorId", "content", "createdAt"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/campuses/{campusId}",
        "definition": {
          "entityName": "Campus",
          "schema": { "$ref": "#/backend/entities/Campus" },
          "description": "Top-level collection for university campus definitions."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores user profiles."
        }
      },
      {
        "path": "/user_market_profiles/{userId}",
        "definition": {
          "entityName": "MarketProfile",
          "schema": { "$ref": "#/backend/entities/MarketProfile" },
          "description": "Stores behavioral commercial intelligence for each user."
        }
      },
      {
        "path": "/creator_reputation/{creatorId}",
        "definition": {
          "entityName": "CreatorReputation",
          "schema": { "$ref": "#/backend/entities/CreatorReputation" },
          "description": "Stores quality scores for content creators."
        }
      },
      {
        "path": "/campus_pulse/{pulseId}",
        "definition": {
          "entityName": "CampusPulse",
          "schema": { "$ref": "#/backend/entities/CampusPulse" },
          "description": "Unified social post feed with AI-driven discovery metadata."
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Marketplace product listings with recommendation metadata."
        }
      }
    ]
  }
}
