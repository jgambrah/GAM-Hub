
{
  "entities": {
    "Campus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name", "domain"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "campusId": { "type": "string" },
        "role": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fcmToken": { "type": "string", "description": "Device token for push notifications." },
        "followedVendors": { "type": "array", "items": { "type": "string" } },
        "qualityScore": { "type": "number", "description": "0-100 reputation score for discovery ranking." }
      },
      "required": ["id", "email", "campusId", "role"]
    },
    "NotificationSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "NotificationSettings",
      "type": "object",
      "description": "User preferences for various notification types and quiet hours.",
      "properties": {
        "userId": { "type": "string" },
        "priceDrops": { "type": "boolean" },
        "trendingProducts": { "type": "boolean" },
        "vendorUpdates": { "type": "boolean" },
        "recommendations": { "type": "boolean" },
        "lastSentAt": { "type": "string", "format": "date-time" },
        "dailyCount": { "type": "number" },
        "quietHours": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "description": "Hour in 24h format (e.g. 22)" },
            "end": { "type": "number", "description": "Hour in 24h format (e.g. 7)" }
          }
        }
      }
    },
    "ProductView": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductView",
      "type": "object",
      "description": "A single instance of a user viewing a product.",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "MarketProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketProfile",
      "type": "object",
      "description": "Tracks a user's commercial intent and shopping behavior.",
      "properties": {
        "viewedCategories": { "type": "object" },
        "purchasedCategories": { "type": "object" },
        "intentCategories": { "type": "object" },
        "favoriteVendors": { "type": "object" },
        "favoriteProducts": { "type": "array", "items": { "type": "string" } },
        "pricePreference": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product listed for sale with discovery metadata.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "averagePrice": { "type": "number", "description": "Historical average price for deal detection." },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "salesCount": { "type": "number" },
        "viewCount": { "type": "number" },
        "favoriteCount": { "type": "number" },
        "shareCount": { "type": "number" },
        "rating": { "type": "number" },
        "trendScore": { "type": "number" },
        "recentSales": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campusId", "vendorId", "name", "price"]
    },
    "Notification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Notification",
      "type": "object",
      "description": "Audit record of a sent push notification with analytics tracking.",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "body": { "type": "string" },
        "type": { "type": "string" },
        "sentAt": { "type": "string", "format": "date-time" },
        "opened": { "type": "boolean" },
        "clicked": { "type": "boolean" },
        "purchased": { "type": "boolean" },
        "relatedProductId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles with notification tokens."
        }
      },
      {
        "path": "/user_notifications/{userId}",
        "definition": {
          "entityName": "NotificationSettings",
          "schema": { "$ref": "#/backend/entities/NotificationSettings" },
          "description": "Personalized notification toggles and quiet hours."
        }
      },
      {
        "path": "/user_product_views/{viewId}",
        "definition": {
          "entityName": "ProductView",
          "schema": { "$ref": "#/backend/entities/ProductView" },
          "description": "Time-stamped log of product interest."
        }
      },
      {
        "path": "/user_market_profiles/{userId}",
        "definition": {
          "entityName": "MarketProfile",
          "schema": { "$ref": "#/backend/entities/MarketProfile" },
          "description": "Stores behavioral commercial intelligence for each user."
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Marketplace product listings with recommendation metadata."
        }
      },
      {
        "path": "/notifications/{notificationId}",
        "definition": {
          "entityName": "Notification",
          "schema": { "$ref": "#/backend/entities/Notification" },
          "description": "Audit log of sent notifications with ROI tracking."
        }
      }
    ]
  }
}
