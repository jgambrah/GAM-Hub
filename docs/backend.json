
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number", "description": "Balance for professional service inquiries." },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "UserIntelligence": {
      "title": "UserIntelligence",
      "type": "object",
      "description": "Unified behavioral brain merging social and commercial signals.",
      "properties": {
        "id": { "type": "string" },
        "interests": { "type": "object", "description": "Weighted interest map (tag -> score)." },
        "affinities": {
          "type": "object",
          "properties": {
            "creators": { "type": "object" },
            "vendors": { "type": "object" }
          }
        },
        "pricePreference": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "engagementLevel": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SocialPost": {
      "title": "SocialPost",
      "type": "object",
      "description": "A vibration shared in the Campus Pulse.",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["youtube", "tiktok", "image", "text", "video"] },
        "mediaUrl": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "campusId": { "type": "string" },
        "productTags": { "type": "array", "items": { "type": "string" } },
        "commerceClicks": { "type": "number" },
        "trendScore": { "type": "number" }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "A marketplace listing (Physical or Service).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" },
        "productType": { "type": "string", "enum": ["physical", "service"] },
        "isSponsored": { "type": "boolean" },
        "clicks": { "type": "number" }
      }
    },
    "MarketRequest": {
      "title": "MarketRequest",
      "type": "object",
      "description": "A student demand signal for an item or service.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "query": { "type": "string" },
        "category": { "type": "string" },
        "campusId": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "closed"] }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "A transaction record in Escrow.",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "affiliateCreatorId": { "type": "string" },
        "commissionRate": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/user_intelligence/{userId}": { "schema": "#/backend/entities/UserIntelligence", "description": "Unified behavioral brain." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "The national stream of campus vibrations." },
    "/products/{productId}": { "schema": "#/backend/entities/Product", "description": "Campus marketplace inventory." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Escrow transaction records." },
    "/market_requests/{requestId}": { "schema": "#/backend/entities/MarketRequest", "description": "Direct student demand signals." },
    "/knowledge_graph/{nodeId}": { "schema": { "title": "KnowledgeGraphNode", "type": "object", "properties": { "id": { "type": "string" }, "type": { "type": "string" }, "connections": { "type": "object" } } }, "description": "Semantic relationship network." }
  }
}
