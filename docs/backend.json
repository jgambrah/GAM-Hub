{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "UserIntelligence": {
      "title": "UserIntelligence",
      "type": "object",
      "description": "Unified behavioral brain merging social and commercial signals.",
      "properties": {
        "id": { "type": "string" },
        "interests": { "type": "object" },
        "affinities": {
          "type": "object",
          "properties": {
            "creators": { "type": "object" },
            "vendors": { "type": "object" }
          }
        },
        "engagementLevel": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "currentStrategy": { "type": "string", "enum": ["A", "B", "C", "D"] },
        "strategyStats": { "type": "object" }
      }
    },
    "SocialPost": {
      "title": "SocialPost",
      "type": "object",
      "description": "A vibration shared in the Campus Pulse.",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["youtube", "tiktok", "image", "text", "video"] },
        "mediaUrl": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "campusId": { "type": "string" },
        "productTags": { "type": "array", "items": { "type": "string" } },
        "commerceClicks": { "type": "number" },
        "trendScore": { "type": "number" }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "A marketplace listing (Physical or Service).",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" },
        "productType": { "type": "string", "enum": ["physical", "service"] },
        "isSponsored": { "type": "boolean" },
        "clicks": { "type": "number" }
      }
    },
    "Order": {
      "title": "Order",
      "type": "object",
      "description": "A transaction record in Escrow.",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Review": {
      "title": "Review",
      "type": "object",
      "description": "Customer feedback for a vendor purchase.",
      "properties": {
        "id": { "type": "string" },
        "orderId": { "type": "string" },
        "vendorId": { "type": "string" },
        "buyerId": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Chat": {
      "title": "Chat",
      "type": "object",
      "description": "A private conversation thread between two users.",
      "properties": {
        "id": { "type": "string" },
        "users": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Message",
      "type": "object",
      "description": "An individual message within a chat or group.",
      "properties": {
        "id": { "type": "string" },
        "text": { "type": "string" },
        "senderId": { "type": "string" },
        "senderName": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "image", "file"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "TrendEvent": {
      "title": "TrendEvent",
      "type": "object",
      "description": "A raw behavioral signal recorded for real-time trend detection.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["video_view", "video_like", "video_share", "product_view", "product_purchase", "vendor_visit", "hashtag_click"] },
        "entityId": { "type": "string" },
        "tag": { "type": "string" },
        "campusId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "TrendScores": {
      "title": "TrendScores",
      "type": "object",
      "description": "Aggregated trending data for the national hub.",
      "properties": {
        "scores": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "BanditStats": {
      "title": "BanditStats",
      "type": "object",
      "description": "Performance tracking for Multi-Armed Bandit feed strategies.",
      "properties": {
        "A": { "type": "object", "properties": { "views": { "type": "number" }, "reward": { "type": "number" } } },
        "B": { "type": "object", "properties": { "views": { "type": "number" }, "reward": { "type": "number" } } },
        "C": { "type": "object", "properties": { "views": { "type": "number" }, "reward": { "type": "number" } } },
        "D": { "type": "object", "properties": { "views": { "type": "number" }, "reward": { "type": "number" } } }
      }
    },
    "VideoConfig": {
      "title": "VideoConfig",
      "type": "object",
      "description": "Infrastructure constraints for video storage and delivery.",
      "properties": {
        "maxSizeMB": { "type": "number" },
        "maxDurationSec": { "type": "number" },
        "allowedTypes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/user_intelligence/{userId}": { "schema": "#/backend/entities/UserIntelligence", "description": "Unified behavioral brain." },
    "/users/{userId}/bandit_stats/current": { "schema": "#/backend/entities/BanditStats", "description": "Personalized Multi-Armed Bandit stats." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "National stream of campus vibrations." },
    "/products/{productId}": { "schema": "#/backend/entities/Product", "description": "Campus marketplace inventory." },
    "/orders/{orderId}": { "schema": "#/backend/entities/Order", "description": "Escrow transaction records." },
    "/reviews/{reviewId}": { "schema": "#/backend/entities/Review", "description": "Vendor feedback records." },
    "/chats/{chatId}": { "schema": "#/backend/entities/Chat", "description": "Private conversation threads." },
    "/chats/{chatId}/messages/{msgId}": { "schema": "#/backend/entities/Message", "description": "Individual chat messages." },
    "/groups/{groupId}": { "schema": { "title": "Group", "type": "object" }, "description": "Campus communities." },
    "/groups/{groupId}/messages/{msgId}": { "schema": "#/backend/entities/Message", "description": "Group community messages." },
    "/trend_events/{eventId}": { "schema": "#/backend/entities/TrendEvent", "description": "Raw real-time behavioral signals." },
    "/trend_scores/{docId}": { "schema": "#/backend/entities/TrendScores", "description": "Aggregated trending intelligence." },
    "/bandit_stats/{docId}": { "schema": "#/backend/entities/BanditStats", "description": "Multi-Armed Bandit performance hub." }
  }
}
