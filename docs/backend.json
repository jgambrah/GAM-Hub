
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "HubWallet": {
      "title": "HubWallet",
      "type": "object",
      "description": "The monetization node for individual users to participate in Arena economy.",
      "properties": {
        "coins": { "type": "number" },
        "totalPurchased": { "type": "number" },
        "totalSpent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreatorWallet": {
      "title": "CreatorWallet",
      "type": "object",
      "description": "Vault for earned coins from battles and gifts.",
      "properties": {
        "earnedCoins": { "type": "number" },
        "totalEarned": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "ArenaTournament": {
      "title": "ArenaTournament",
      "type": "object",
      "description": "Structured competition with entry fees and brackets.",
      "properties": {
        "name": { "type": "string" },
        "entryFeeCoins": { "type": "number" },
        "maxPlayers": { "type": "number" },
        "currentPlayers": { "type": "number" },
        "prizePool": { "type": "number" },
        "status": { "type": "string", "enum": ["registration", "ongoing", "finished"] },
        "startTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "entryFeeCoins", "maxPlayers", "status"]
    },
    "ArenaMatch": {
      "title": "ArenaMatch",
      "type": "object",
      "description": "A single head-to-head match within a tournament round.",
      "properties": {
        "playerA": { "type": "string" },
        "playerB": { "type": "string" },
        "playerAName": { "type": "string" },
        "playerBName": { "type": "string" },
        "winner": { "type": "string" },
        "round": { "type": "number" },
        "battleId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "live", "completed"] }
      }
    },
    "SocialPost": {
      "title": "SocialPost",
      "type": "object",
      "description": "A vibration shared in the Yard or an Arena highlight.",
      "properties": {
        "isPromoted": { "type": "boolean", "description": "Flag for paid highlight boosting." },
        "promotionLevel": { "type": "string", "enum": ["none", "small", "medium", "large"] },
        "promotionViewsTarget": { "type": "number" },
        "promotionViewsDelivered": { "type": "number" }
      }
    },
    "HighlightStats": {
      "title": "HighlightStats",
      "type": "object",
      "description": "Granular engagement metrics for a promoted highlight.",
      "properties": {
        "views": { "type": "number" },
        "likes": { "type": "number" },
        "shares": { "type": "number" },
        "followersGained": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/wallets/{userId}": { "schema": "#/backend/entities/HubWallet", "description": "Private coin balances." },
    "/creator_wallets/{userId}": { "schema": "#/backend/entities/CreatorWallet", "description": "Earnings vault for creators." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Real-time Arena competitions." },
    "/arena_tournaments/{tournamentId}": { "schema": "#/backend/entities/ArenaTournament", "description": "Organized competitions." },
    "/arena_tournaments/{tournamentId}/matches/{matchId}": { "schema": "#/backend/entities/ArenaMatch", "description": "Individual matches within a tournament round." },
    "/sponsor_stats/{battleId}": { "schema": "#/backend/entities/SponsorStats", "description": "ROI metrics for brand partners." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "Unified feed posts and promoted highlights." },
    "/highlight_stats/{highlightId}": { "schema": "#/backend/entities/HighlightStats", "description": "Detailed ROI analytics for promoted vibrations." }
  }
}
