
{
  "entities": {
    "Campus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name", "domain"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "campusId": { "type": "string" },
        "role": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fcmToken": { "type": "string", "description": "Device token for push notifications." },
        "followedVendors": { "type": "array", "items": { "type": "string" } },
        "qualityScore": { "type": "number", "description": "0-100 reputation score for discovery ranking." }
      },
      "required": ["id", "email", "campusId", "role"]
    },
    "SocialPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SocialPost",
      "type": "object",
      "description": "Represents a social vibration (post) in the Yard Pulse.",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["youtube", "tiktok", "image", "text", "video"] },
        "mediaUrl": { "type": "string" },
        "productTags": { "type": "array", "items": { "type": "string" } },
        "campusId": { "type": "string" },
        "commerceClicks": { "type": "number", "description": "Total clicks driven to tagged products." }
      },
      "required": ["authorId", "content", "campusId"]
    },
    "NotificationSettings": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "NotificationSettings",
      "type": "object",
      "description": "User preferences for various notification types and quiet hours.",
      "properties": {
        "userId": { "type": "string" },
        "priceDrops": { "type": "boolean" },
        "trendingProducts": { "type": "boolean" },
        "vendorUpdates": { "type": "boolean" },
        "recommendations": { "type": "boolean" },
        "lastSentAt": { "type": "string", "format": "date-time" },
        "dailyCount": { "type": "number" },
        "quietHours": {
          "type": "object",
          "properties": {
            "start": { "type": "number", "description": "Hour in 24h format (e.g. 22)" },
            "end": { "type": "number", "description": "Hour in 24h format (e.g. 7)" }
          }
        }
      }
    },
    "ProductView": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "ProductView",
      "type": "object",
      "description": "A single instance of a user viewing a product.",
      "properties": {
        "userId": { "type": "string" },
        "productId": { "type": "string" },
        "viewedAt": { "type": "string", "format": "date-time" }
      }
    },
    "MarketProfile": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "MarketProfile",
      "type": "object",
      "description": "Tracks a user's commercial intent and shopping behavior.",
      "properties": {
        "viewedCategories": { "type": "object" },
        "purchasedCategories": { "type": "object" },
        "intentCategories": { "type": "object" },
        "favoriteVendors": { "type": "object" },
        "favoriteProducts": { "type": "array", "items": { "type": "string" } },
        "pricePreference": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product listed for sale with discovery metadata.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "averagePrice": { "type": "number", "description": "Historical average price for deal detection." },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" },
        "category": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "salesCount": { "type": "number" },
        "viewCount": { "type": "number" },
        "favoriteCount": { "type": "number" },
        "shareCount": { "type": "number" },
        "rating": { "type": "number" },
        "trendScore": { "type": "number" },
        "recentSales": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campusId", "vendorId", "name", "price"]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "A transaction record for a product or service.",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "productId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "affiliateCreatorId": { "type": "string", "description": "ID of the creator who drove this sale via tagged video." },
        "commissionRate": { "type": "number", "description": "Percentage earned by the affiliate." }
      }
    },
    "VideoProductClick": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "VideoProductClick",
      "type": "object",
      "description": "Tracks conversion from video engagement to marketplace discovery.",
      "properties": {
        "videoId": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["videoId", "productId", "userId"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles with notification tokens."
        }
      },
      {
        "path": "/campus_pulse/{postId}",
        "definition": {
          "entityName": "SocialPost",
          "schema": { "$ref": "#/backend/entities/SocialPost" },
          "description": "The unified stream of campus vibrations."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": { "$ref": "#/backend/entities/Order" },
          "description": "Marketplace transaction records."
        }
      },
      {
        "path": "/video_product_clicks/{clickId}",
        "definition": {
          "entityName": "VideoProductClick",
          "schema": { "$ref": "#/backend/entities/VideoProductClick" },
          "description": "Audit trail of commerce conversions from social content."
        }
      }
    ]
  }
}
