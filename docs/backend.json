
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "Notification": {
      "title": "Notification",
      "type": "object",
      "description": "A real-time alert for a user.",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["like", "comment", "message", "order", "system"] },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "link": { "type": "string" },
        "actorId": { "type": "string" },
        "actorName": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "SocialPost": {
      "title": "SocialPost",
      "type": "object",
      "description": "A vibration shared in the Campus Pulse.",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["youtube", "tiktok", "image", "text", "video"] },
        "mediaUrl": { "type": "string" },
        "hlsUrl": { "type": "string" },
        "imageUrl": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "tags": { "type": "array", "items": { "type": "string" } },
        "campusId": { "type": "string" },
        "trendScore": { "type": "number" }
      }
    },
    "Product": {
      "title": "Product",
      "type": "object",
      "description": "Campus marketplace item.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "category": { "type": "string" },
        "embedding": { "type": "array", "items": { "type": "number" } },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/users/{userId}/notifications/{notifId}": { "schema": "#/backend/entities/Notification", "description": "User notification sub-collection." },
    "/user_intelligence/{userId}": { "schema": "#/backend/entities/UserIntelligence", "description": "Recommendation profiles." },
    "/video_hashes/{hash}": { "schema": "#/backend/entities/VideoHash", "description": "Deduplication registry." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "National stream of campus vibrations." },
    "/products/{productId}": { "schema": "#/backend/entities/Product", "description": "Campus marketplace inventory." }
  }
}
