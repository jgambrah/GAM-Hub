
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "boolean": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "ArenaBattle": {
      "title": "ArenaBattle",
      "type": "object",
      "description": "A real-time competitive dual-stream battle in the Arena.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "creatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["live", "ended"] },
        "opponentA": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "videoUrl": { "type": "string" },
            "votes": { "type": "number" }
          }
        },
        "opponentB": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "videoUrl": { "type": "string" },
            "votes": { "type": "number" }
          }
        },
        "aiVerdict": {
          "type": "object",
          "properties": {
            "verdict": { "type": "string" },
            "burnLevel": { "type": "number" },
            "winner": { "type": "string" },
            "refereeAdvice": { "type": "string" }
          }
        },
        "participantInfo": { "type": "object" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "viewerCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "status", "opponentA", "opponentB"]
    },
    "BattleMessage": {
      "title": "BattleMessage",
      "type": "object",
      "description": "A chat message or video attack within a live battle.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "text": { "type": "string" },
        "mediaUrl": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["youtube", "tiktok", "native"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BattleReaction": {
      "title": "BattleReaction",
      "type": "object",
      "description": "A live emoji reaction during a battle.",
      "properties": {
        "emoji": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "BattlePowerUp": {
      "title": "BattlePowerUp",
      "type": "object",
      "description": "A weighted audience boost during a battle.",
      "properties": {
        "userId": { "type": "string" },
        "target": { "type": "string", "enum": ["A", "B"] },
        "type": { "type": "string" },
        "weight": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "target", "type", "weight"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Real-time Arena competitions." },
    "/arena_battles/{battleId}/messages/{msgId}": { "schema": "#/backend/entities/BattleMessage", "description": "Live chat and video attacks." },
    "/arena_battles/{battleId}/user_votes/{userId}": { "description": "Audit trail for voting to prevent duplicates." },
    "/arena_battles/{battleId}/reactions/{reactionId}": { "schema": "#/backend/entities/BattleReaction", "description": "Live emoji reactions." },
    "/arena_battles/{battleId}/powerups/{powerupId}": { "schema": "#/backend/entities/BattlePowerUp", "description": "Weighted audience boosts." },
    "/arena_leaderboard/{userId}": { "schema": "#/backend/entities/ArenaLeaderboard", "description": "Individual Arena rankings." }
  }
}
