
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "boolean": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "ArenaBattle": {
      "title": "ArenaBattle",
      "type": "object",
      "description": "A real-time competitive dual-stream battle in the Arena.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "creatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["live", "ended"] },
        "opponentA": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "videoUrl": { "type": "string" },
            "votes": { "type": "number" }
          }
        },
        "opponentB": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "videoUrl": { "type": "string" },
            "votes": { "type": "number" }
          }
        },
        "participantInfo": { "type": "object" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "viewerCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "status", "opponentA", "opponentB"]
    },
    "BattleCounterAttack": {
      "title": "BattleCounterAttack",
      "type": "object",
      "description": "A video comeback reply within a live battle.",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "videoUrl": { "type": "string" },
        "type": { "type": "string", "enum": ["youtube", "tiktok", "native"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "videoUrl", "type"]
    },
    "ArenaLeaderboard": {
      "title": "ArenaLeaderboard",
      "type": "object",
      "description": "Individual stats for Arena competitors.",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "campusAcronym": { "type": "string" },
        "wins": { "type": "number" },
        "losses": { "type": "number" },
        "votes_received": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Real-time Arena competitions." },
    "/arena_battles/{battleId}/messages/{msgId}": { "description": "Live chat for battles." },
    "/arena_battles/{battleId}/user_votes/{userId}": { "description": "Audit trail for voting to prevent duplicates." },
    "/arena_battles/{battleId}/counter_attacks/{attackId}": { "schema": "#/backend/entities/BattleCounterAttack", "description": "Video artillery replies." },
    "/arena_leaderboard/{userId}": { "schema": "#/backend/entities/ArenaLeaderboard", "description": "Individual Arena rankings." }
  }
}
