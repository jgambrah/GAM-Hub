
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] },
        "subscribedCreators": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "email", "role"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "type": "object",
      "description": "Anti-fraud audit node mapping users to hardware fingerprints.",
      "properties": {
        "userId": { "type": "string" },
        "deviceHash": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserBehavior": {
      "title": "UserBehavior",
      "type": "object",
      "description": "Daily engagement tracking for bot detection.",
      "properties": {
        "votesToday": { "type": "number" },
        "giftsSent": { "type": "number" },
        "watchTime": { "type": "number" },
        "isBlocked": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "FraudLog": {
      "title": "FraudLog",
      "type": "object",
      "description": "Official audit trail for suspicious Arena activity.",
      "properties": {
        "type": { "type": "string", "enum": ["suspicious_votes", "multi_account_device", "gift_spam", "bot_pattern"] },
        "userId": { "type": "string" },
        "battleId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "ContentReport": {
      "title": "ContentReport",
      "type": "object",
      "description": "User-submitted report for content moderation.",
      "properties": {
        "targetId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["post", "battle", "comment"] },
        "reportedUserId": { "type": "string" },
        "reportedById": { "type": "string" },
        "reason": { "type": "string", "enum": ["harassment", "spam", "nudity", "hate_speech", "other"] },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved"] },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/user_devices/{deviceId}": { "schema": "#/backend/entities/UserDevice", "description": "Device-to-user mappings." },
    "/user_behavior/{userId}": { "schema": "#/backend/entities/UserBehavior", "description": "Behavioral analytics." },
    "/fraud_logs/{logId}": { "schema": "#/backend/entities/FraudLog", "description": "Audit trail for suspicious activity." },
    "/content_reports/{reportId}": { "schema": "#/backend/entities/ContentReport", "description": "Moderation reports." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "Unified feed posts." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Live and past battles." }
  }
}
