
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] },
        "subscribedCreators": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["id", "email", "role"]
    },
    "GiftCombo": {
      "title": "GiftCombo",
      "type": "object",
      "description": "Tracks rapid gifting streaks for vote multipliers.",
      "properties": {
        "userId": { "type": "string" },
        "battleId": { "type": "string" },
        "comboCount": { "type": "number" },
        "lastGiftTime": { "type": "string", "format": "date-time" },
        "comboMultiplier": { "type": "number" },
        "giftType": { "type": "string" }
      }
    },
    "UserAchievement": {
      "title": "UserAchievement",
      "type": "object",
      "description": "Tracks permanent prestige milestones for users.",
      "properties": {
        "fireStarter": { "type": "boolean" },
        "giftMachine": { "type": "boolean" },
        "arenaLegend": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/user_devices/{deviceId}": { "schema": "#/backend/entities/UserDevice", "description": "Device-to-user mappings." },
    "/user_behavior/{userId}": { "schema": "#/backend/entities/UserBehavior", "description": "Behavioral analytics." },
    "/fraud_logs/{logId}": { "schema": "#/backend/entities/FraudLog", "description": "Audit trail for suspicious activity." },
    "/content_reports/{reportId}": { "schema": "#/backend/entities/ContentReport", "description": "Moderation reports." },
    "/gift_combos/{comboId}": { "schema": "#/backend/entities/GiftCombo", "description": "Real-time combo tracking." },
    "/user_achievements/{userId}": { "schema": "#/backend/entities/UserAchievement", "description": "Permanent achievements." },
    "/battle_combo_leaders/{battleId}": { "description": "Tracks the top combo counts per battle." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "Unified feed posts." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Live and past battles." }
  }
}
