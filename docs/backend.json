
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] },
        "subscribedCreators": { "type": "array", "items": { "type": "string" }, "description": "Cached list of active creator subscriptions for the user." }
      },
      "required": ["id", "email", "role"]
    },
    "UserDevice": {
      "title": "UserDevice",
      "type": "object",
      "description": "Anti-fraud audit node mapping users to hardware fingerprints.",
      "properties": {
        "userId": { "type": "string" },
        "deviceHash": { "type": "string" },
        "lastSeen": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "UserBehavior": {
      "title": "UserBehavior",
      "type": "object",
      "description": "Daily engagement tracking for bot detection.",
      "properties": {
        "votesToday": { "type": "number" },
        "giftsSent": { "type": "number" },
        "watchTime": { "type": "number", "description": "Engagement time in seconds." },
        "isBlocked": { "type": "boolean" },
        "lastUpdated": { "type": "string", "format": "date-time" }
      }
    },
    "FraudLog": {
      "title": "FraudLog",
      "type": "object",
      "description": "Official audit trail for suspicious Arena activity.",
      "properties": {
        "type": { "type": "string", "enum": ["suspicious_votes", "multi_account_device", "gift_spam", "bot_pattern"] },
        "userId": { "type": "string" },
        "battleId": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "HubWallet": {
      "title": "HubWallet",
      "type": "object",
      "description": "The monetization node for individual users to participate in Arena economy.",
      "properties": {
        "coins": { "type": "number" },
        "totalPurchased": { "type": "number" },
        "totalSpent": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreatorWallet": {
      "title": "CreatorWallet",
      "type": "object",
      "description": "Vault for earned coins from battles and gifts.",
      "properties": {
        "earnedCoins": { "type": "number" },
        "totalEarned": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreatorSettings": {
      "title": "CreatorSettings",
      "type": "object",
      "description": "Commercial governance for individual creators.",
      "properties": {
        "subscriptionsEnabled": { "type": "boolean" },
        "subscriptionPrice": { "type": "number", "enum": [2, 3, 5] },
        "subscriberCount": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreatorAnalytics": {
      "title": "CreatorAnalytics",
      "type": "object",
      "description": "Business intelligence for creators to track subscription ROI.",
      "properties": {
        "activeSubscribers": { "type": "number" },
        "monthlyIncomeGHS": { "type": "number" },
        "totalNetEarningsGHS": { "type": "number" },
        "newSubscribersLast30": { "type": "number" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "CreatorSubscription": {
      "title": "CreatorSubscription",
      "type": "object",
      "description": "Monthly recurring support from a fan to a creator (Billing Record).",
      "properties": {
        "creatorId": { "type": "string" },
        "subscriberId": { "type": "string" },
        "priceMonthly": { "type": "number" },
        "status": { "type": "string", "enum": ["active", "cancelled", "expired"] },
        "startDate": { "type": "string", "format": "date-time" },
        "renewalDate": { "type": "string", "format": "date-time" }
      },
      "required": ["creatorId", "subscriberId", "status"]
    },
    "CreatorSubscriber": {
      "title": "CreatorSubscriber",
      "type": "object",
      "description": "Inner Circle membership record for gating benefits.",
      "properties": {
        "subscriberSince": { "type": "string", "format": "date-time" }
      }
    },
    "ArenaTournament": {
      "title": "ArenaTournament",
      "type": "object",
      "description": "Structured competition with entry fees and brackets.",
      "properties": {
        "name": { "type": "string" },
        "entryFeeCoins": { "type": "number" },
        "maxPlayers": { "type": "number" },
        "currentPlayers": { "type": "number" },
        "prizePool": { "type": "number" },
        "status": { "type": "string", "enum": ["registration", "ongoing", "finished"] },
        "startTime": { "type": "string", "format": "date-time" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "entryFeeCoins", "maxPlayers", "status"]
    },
    "BattleVote": {
      "title": "BattleVote",
      "type": "object",
      "description": "Anti-fraud audit node for battle voting rate limits.",
      "properties": {
        "lastVoteTime": { "type": "string", "format": "date-time" },
        "voteCount": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/user_devices/{deviceId}": { "schema": "#/backend/entities/UserDevice", "description": "Device-to-user mappings for Sybil protection." },
    "/user_behavior/{userId}": { "schema": "#/backend/entities/UserBehavior", "description": "Behavioral analytics for bot detection." },
    "/fraud_logs/{logId}": { "schema": "#/backend/entities/FraudLog", "description": "Audit trail for suspicious activity." },
    "/wallets/{userId}": { "schema": "#/backend/entities/HubWallet", "description": "Private coin balances." },
    "/creator_wallets/{userId}": { "schema": "#/backend/entities/CreatorWallet", "description": "Earnings vault for creators." },
    "/creator_settings/{userId}": { "schema": "#/backend/entities/CreatorSettings", "description": "Subscription and commercial settings for creators." },
    "/creator_analytics/{userId}": { "schema": "#/backend/entities/CreatorAnalytics", "description": "ROI and income tracking for talent." },
    "/creator_subscriptions/{subId}": { "schema": "#/backend/entities/CreatorSubscription", "description": "Recurring fan support audit trail." },
    "/creator_subscribers/{creatorId}/subscribers/{subscriberId}": { "schema": "#/backend/entities/CreatorSubscriber", "description": "Inner Circle membership list for benefit gating." },
    "/arena_tournaments/{tournamentId}": { "schema": "#/backend/entities/ArenaTournament", "description": "Organized competitions." },
    "/battle_votes/{battleId}/users/{userId}": { "schema": "#/backend/entities/BattleVote", "description": "Voting frequency audit nodes." },
    "/campus_pulse/{postId}": { "schema": "#/backend/entities/SocialPost", "description": "Unified feed posts and promoted highlights." }
  }
}
