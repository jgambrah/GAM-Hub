
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "ArenaBattle": {
      "title": "ArenaBattle",
      "type": "object",
      "description": "A real-time competitive battle in the Arena.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "creatorId": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["live", "ended"] },
        "streamUrl": { "type": "string" },
        "votes": { "type": "object", "additionalProperties": { "type": "number" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "title", "creatorId", "participants", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Real-time Arena competitions." },
    "/arena_battles/{battleId}/messages/{msgId}": { "description": "Live chat for battles." },
    "/arena_battles/{battleId}/user_votes/{userId}": { "description": "Audit trail for voting to prevent duplicates." }
  }
}
