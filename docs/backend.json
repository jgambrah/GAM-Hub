
{
  "entities": {
    "Campus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name", "domain"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "campusId": { "type": "string" },
        "role": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" },
        "fcmToken": { "type": "string", "description": "Device token for push notifications." },
        "followedVendors": { "type": "array", "items": { "type": "string" } },
        "qualityScore": { "type": "number", "description": "0-100 reputation score for discovery ranking." }
      },
      "required": ["id", "email", "campusId", "role"]
    },
    "UserIntelligence": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "UserIntelligence",
      "type": "object",
      "description": "Unified behavioral profile combining social and commercial signals.",
      "properties": {
        "interests": { "type": "object", "description": "Map of tags/categories to weight scores." },
        "affinities": {
          "type": "object",
          "properties": {
            "creators": { "type": "object" },
            "vendors": { "type": "object" }
          }
        },
        "pricePreference": {
          "type": "object",
          "properties": {
            "min": { "type": "number" },
            "max": { "type": "number" }
          }
        },
        "engagementLevel": { "type": "number", "description": "0-1 score of platform activity." },
        "vibeEmbedding": { "type": "array", "items": { "type": "number" } },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "SocialPost": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "SocialPost",
      "type": "object",
      "description": "Represents a social vibration (post) in the Yard Pulse.",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string", "enum": ["youtube", "tiktok", "image", "text", "video"] },
        "mediaUrl": { "type": "string" },
        "productTags": { "type": "array", "items": { "type": "string" } },
        "campusId": { "type": "string" },
        "commerceClicks": { "type": "number", "description": "Total clicks driven to tagged products." }
      },
      "required": ["authorId", "content", "campusId"]
    },
    "KnowledgeGraphNode": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "KnowledgeGraphNode",
      "description": "Represents a node in the platform's relationship network.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "type": { "type": "string", "enum": ["tag", "category", "creator", "vendor", "location", "product"] },
        "name": { "type": "string" },
        "connections": { 
          "type": "object",
          "description": "Map of target node IDs to weight metadata."
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "type", "name"]
    },
    "Order": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Order",
      "type": "object",
      "description": "A transaction record for a product or service.",
      "properties": {
        "id": { "type": "string" },
        "buyerId": { "type": "string" },
        "vendorId": { "type": "string" },
        "productId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" },
        "affiliateCreatorId": { "type": "string", "description": "ID of the creator who drove this sale." },
        "commissionRate": { "type": "number" }
      }
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "User profiles with notification tokens."
        }
      },
      {
        "path": "/user_intelligence/{userId}",
        "definition": {
          "entityName": "UserIntelligence",
          "schema": { "$ref": "#/backend/entities/UserIntelligence" },
          "description": "Unified behavioral brain for every citizen."
        }
      },
      {
        "path": "/campus_pulse/{postId}",
        "definition": {
          "entityName": "SocialPost",
          "schema": { "$ref": "#/backend/entities/SocialPost" },
          "description": "The unified stream of campus vibrations."
        }
      },
      {
        "path": "/knowledge_graph/{nodeId}",
        "definition": {
          "entityName": "KnowledgeGraphNode",
          "schema": { "$ref": "#/backend/entities/KnowledgeGraphNode" },
          "description": "The shared intelligence graph connecting all campus entities."
        }
      },
      {
        "path": "/orders/{orderId}",
        "definition": {
          "entityName": "Order",
          "schema": { "$ref": "#/backend/entities/Order" },
          "description": "Marketplace transaction records."
        }
      }
    ]
  }
}
