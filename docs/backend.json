
{
  "entities": {
    "Campus": {
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "acronym": { "type": "string" },
        "domain": { "type": "string" },
        "studentDomain": { "type": "string" },
        "staffDomain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "User": {
      "title": "User",
      "type": "object",
      "description": "Represents a user account (Student, Staff, Vendor, or Admin).",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["student", "staff", "vendor", "admin", "src", "management"] },
        "campusId": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "contactPhone": { "type": "string" },
        "momoNumber": { "type": "string" },
        "momoName": { "type": "string" },
        "lead_credits": { "type": "number" },
        "isVerified": { "boolean": "boolean" },
        "idVerificationStatus": { "type": "string", "enum": ["unverified", "pending", "approved"] }
      },
      "required": ["id", "email", "role"]
    },
    "ArenaBattle": {
      "title": "ArenaBattle",
      "type": "object",
      "description": "A real-time competitive dual-stream battle in the Arena.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "creatorId": { "type": "string" },
        "status": { "type": "string", "enum": ["waiting", "live", "ended"] },
        "opponentA": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "videoUrl": { "type": "string" },
            "votes": { "type": "number" }
          }
        },
        "opponentB": {
          "type": "object",
          "properties": {
            "userId": { "type": "string" },
            "videoUrl": { "type": "string" },
            "votes": { "type": "number" }
          }
        },
        "aiVerdict": {
          "type": "object",
          "properties": {
            "verdict": { "type": "string" },
            "burnLevel": { "type": "number" },
            "winner": { "type": "string" },
            "refereeAdvice": { "type": "string" }
          }
        },
        "participants": { "type": "array", "items": { "type": "string" } },
        "viewerCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      }
    },
    "ArenaHighlight": {
      "title": "ArenaHighlight",
      "type": "object",
      "description": "A viral clip extracted from an ended Arena battle.",
      "properties": {
        "battleId": { "type": "string" },
        "clipUrl": { "type": "string" },
        "creatorId": { "type": "string" },
        "opponentId": { "type": "string" },
        "startTime": { "type": "number" },
        "endTime": { "type": "number" },
        "votesSpike": { "type": "number" },
        "winnerId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "CampusWar": {
      "title": "CampusWar",
      "type": "object",
      "description": "Large-scale inter-university competition.",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "campusAId": { "type": "string" },
        "campusBId": { "type": "string" },
        "votesA": { "type": "number" },
        "votesB": { "type": "number" },
        "status": { "type": "string", "enum": ["live", "ended"] },
        "viewerCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "endsAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "campusAId", "campusBId", "status"]
    }
  },
  "auth": {
    "providers": ["password"]
  },
  "firestore": {
    "/users/{userId}": { "schema": "#/backend/entities/User", "description": "Global user profiles." },
    "/arena_battles/{battleId}": { "schema": "#/backend/entities/ArenaBattle", "description": "Real-time Arena competitions." },
    "/arena_highlights/{highlightId}": { "schema": "#/backend/entities/ArenaHighlight", "description": "Viral battle archive." },
    "/arena_waiting_pool/{entryId}": { "schema": "#/backend/entities/ArenaWaitingPoolEntry", "description": "Staging queue for auto-match pairings." },
    "/campus_wars/{warId}": { "schema": "#/backend/entities/CampusWar", "description": "Large-scale University vs University wars." },
    "/campus_leaderboard/{campusId}": { "description": "National University rankings." }
  }
}
