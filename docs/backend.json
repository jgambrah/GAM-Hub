
{
  "entities": {
    "Campus": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Campus",
      "type": "object",
      "description": "Represents a university campus within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "domain": { "type": "string" },
        "location": { "type": "string" },
        "primaryColor": { "type": "string" },
        "secondaryColor": { "type": "string" },
        "radioName": { "type": "string" },
        "radioStreamUrl": { "type": "string" }
      },
      "required": ["id", "name", "domain", "createdAt"]
    },
    "User": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "User",
      "type": "object",
      "description": "Represents a user account within the GAM Hub platform.",
      "properties": {
        "id": { "type": "string" },
        "email": { "type": "string" },
        "campusId": { "type": "string" },
        "role": { "type": "string" },
        "firstName": { "type": "string" },
        "lastName": { "type": "string" }
      },
      "required": ["id", "email", "campusId", "role"]
    },
    "Product": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Product",
      "type": "object",
      "description": "Represents a product listed for sale.",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "price": { "type": "number" },
        "vendorId": { "type": "string" },
        "campusId": { "type": "string" }
      },
      "required": ["id", "campusId", "vendorId", "name", "price"]
    },
    "CampusPulse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "CampusPulse",
      "type": "object",
      "description": "Represents a unified social post in the flat campus_pulse collection.",
      "properties": {
        "id": { "type": "string" },
        "campusId": { "type": "string" },
        "authorId": { "type": "string" },
        "content": { "type": "string" },
        "mediaType": { "type": "string" },
        "isArenaEntry": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "campusId", "authorId", "content", "createdAt"]
    },
    "Manifesto": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Manifesto",
      "type": "object",
      "description": "Represents a candidate's political manifesto.",
      "properties": {
        "id": { "type": "string" },
        "candidateName": { "type": "string" },
        "position": { "type": "string" },
        "campusId": { "type": "string" },
        "campusAcronym": { "type": "string" },
        "hall": { "type": "string" },
        "motto": { "type": "string" },
        "fullManifesto": { "type": "string" },
        "campaignVideoUrl": { "type": "string" },
        "status": { "type": "string" },
        "endorsements": { "type": "number" },
        "candidateImage": { "type": "string" }
      },
      "required": ["id", "candidateName", "position", "campusId", "status", "endorsements"]
    }
  },
  "auth": {
    "providers": ["password", "anonymous"]
  },
  "firestore": {
    "structure": [
      {
        "path": "/campuses/{campusId}",
        "definition": {
          "entityName": "Campus",
          "schema": { "$ref": "#/backend/entities/Campus" },
          "description": "Top-level collection for university campus definitions."
        }
      },
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "User",
          "schema": { "$ref": "#/backend/entities/User" },
          "description": "Stores user profiles."
        }
      },
      {
        "path": "/products/{productId}",
        "definition": {
          "entityName": "Product",
          "schema": { "$ref": "#/backend/entities/Product" },
          "description": "Marketplace items."
        }
      },
      {
        "path": "/campus_pulse/{pulseId}",
        "definition": {
          "entityName": "CampusPulse",
          "schema": { "$ref": "#/backend/entities/CampusPulse" },
          "description": "UNIFIED FLAT PATH: All campus vibrations and arena entries live here for high-trust access."
        }
      },
      {
        "path": "/manifestos/{manifestoId}",
        "definition": {
          "entityName": "Manifesto",
          "schema": { "$ref": "#/backend/entities/Manifesto" },
          "description": "Political manifestos for campus elections."
        }
      }
    ]
  }
}
